# Novelova — contoh konfigurasi. Salin ke .env lalu sesuaikan.
# Hanya variabel berawalan VITE_ yang sampai ke browser. Jangan pernah menaruh
# rahasia di sini: seluruh isinya ikut ter-bundel dan terbaca siapa pun.

# ── Seam API (architecture.md §5) ───────────────────────────────────────────
# mock = Dexie/IndexedDB di perangkat ini · http = backend nyata (stub di v1)
VITE_API_MODE=mock

# Dipakai hanya saat VITE_API_MODE=http
VITE_API_BASE_URL=http://localhost:8080/api

# Menunda balasan mock supaya keadaan "memuat" benar-benar terlihat saat
# membangun UI. 0 = tanpa jeda.
VITE_MOCK_LATENCY_MS=180

# ── Provider yang dapat ditukar (architecture.md §11) ───────────────────────
# mock = timer + status palsu · midtrans / admob = v2
VITE_PAYMENT_PROVIDER=mock
VITE_AD_PROVIDER=mock

# Kunci publik penyedia pembayaran (client key, bukan server key).
# Kosongkan selama VITE_PAYMENT_PROVIDER=mock.
VITE_MIDTRANS_CLIENT_KEY=

# ── PWA & push (architecture.md §10.4) ──────────────────────────────────────
# VAPID public key. Kosong = push disimulasikan dari server-mock.
VITE_VAPID_PUBLIC_KEY=

# ── Lain-lain ──────────────────────────────────────────────────────────────
VITE_APP_VERSION=0.1.0
# Versi minimum yang boleh dipakai; di bawah ini memicu layar APP-426 (§1.4).
VITE_MIN_SUPPORTED_VERSION=0.1.0
